#!/usr/bin/env bash
#
# nog-cli - list rdaily.live sports matches, fuzzy-pick one, and resolve/open
#           its broadcast ("Broadcast TV") stream link on iplayer.is.
#
# Pipeline (reverse-engineered from rdaily.live's main.js / match.js):
#   1. Fetch the Flashscore day feed:
#        https://1.newsoccers.one/2/x/feed/f_<sportId>_<dayOffset>_1_en_1
#      and parse events (AA=id, AE=home, AF=away, AD=kickoff ts).
#   2. User fuzzy-picks a match.
#   3. Resolve broadcast links from the local override API:
#        https://rdaily.live/api/v1/match/FS:<eventId>   -> custom_urls[]
#      Each custom_urls[].url is a 32-hex token.
#   4. Final broadcast link = https://iplayer.is/beta/<token>
#
set -o pipefail

version_number="1.5.0"

# --- endpoints / constants (from rdaily.live JS) ----------------------------
FLASH_BASE="https://1.newsoccers.one/2/x/feed"
FLASH_FSIGN="SW9D1eZo"
API_BASE="https://rdaily.live/api/v1/match"
PLAYER_BASE="https://iplayer.is/beta/"
# HLS edge servers 403 without an iplayer.is Referer; mpv/curl must send it.
STREAM_REFERER="https://iplayer.is/"
UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"

# sport name -> Flashscore sportId (from the SPORTS table in main.js)
sport_id() {
    case "$1" in
        football)          echo 1  ;;
        tennis)            echo 2  ;;
        basketball)        echo 3  ;;
        hockey)            echo 4  ;;
        american-football|nfl) echo 5 ;;
        handball)          echo 7  ;;
        futsal)            echo 11 ;;
        volleyball)        echo 12 ;;
        darts)             echo 14 ;;
        snooker)           echo 15 ;;
        boxing)            echo 16 ;;
        mma)               echo 28 ;;
        motorsport|f1)     echo 31 ;;
        winter-sports)     echo 37 ;;
        *)                 echo "" ;;
    esac
}

# ---------------------------------------------------------------------------
# UI helpers
# ---------------------------------------------------------------------------

detect_menu() {
    if [ -n "$MENU" ]; then
        menu_program="$MENU"
        return
    fi
    for prog in fzf rofi dmenu; do
        if command -v "$prog" >/dev/null 2>&1; then
            menu_program="$prog"
            return
        fi
    done
    menu_program="builtin"
}

# menu PROMPT < choices-on-stdin  ->  prints the chosen line to stdout
menu() {
    local prompt="$1"
    case "$menu_program" in
        fzf)     fzf --reverse --cycle --prompt "$prompt " ;;
        rofi)    rofi -sort -dmenu -i -p "$prompt" ;;
        dmenu)   dmenu -l 20 -p "$prompt" ;;
        builtin) builtin_menu "$prompt" ;;
        *)       "$menu_program" ;;
    esac
}

builtin_menu() {
    local prompt="$1"
    local -a choices=()
    local line
    while IFS= read -r line; do
        [ -n "$line" ] && choices+=("$line")
    done
    [ "${#choices[@]}" -eq 0 ] && return 1

    local i=1
    for line in "${choices[@]}"; do
        printf '%3d) %s\n' "$i" "$line" >&2
        i=$((i + 1))
    done

    local reply
    printf '%s ' "$prompt" >&2
    read -r reply </dev/tty || return 1
    case "$reply" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$reply" -ge 1 ] && [ "$reply" -le "${#choices[@]}" ] || return 1
    printf '%s\n' "${choices[$((reply - 1))]}"
}

die() {
    printf "\033[1;31m%s\033[0m\n" "$*" >&2
    exit 1
}

info() {
    printf "\033[1;34m%s\033[0m\n" "$*" >&2
}

